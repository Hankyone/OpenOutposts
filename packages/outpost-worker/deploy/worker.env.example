# Environment for an OpenOutposts worker.
# Install as /etc/openoutposts/worker.env. Enroll the machine as the same
# account that runs the service before starting it. The saved identity carries
# the machine ID, key, control-plane URL, display name, and workspace roots.

# Optional: override where the service loads the saved identity.
# OPENOUTPOSTS_STATE_DIR=/var/lib/openoutposts

# Optional: override the control-plane URL stored during enrollment.
# OPENOUTPOSTS_CONTROL_PLANE_URL=https://control-plane.example.com
