# Environment for the OpenOutposts central homestead.
# Install as /etc/openoutposts/homestead.env with mode 0600. The secret signs
# this homestead's requests, and a signature authorizes leases and tool calls.
# Terraform generates it: read it from the `homestead_service_auth_secret`
# output. Each request is signed over its own method, path and body, so it
# authorizes that one request rather than anything on any machine.

# Required.
OPENOUTPOSTS_CONTROL_PLANE_URL=https://control-plane.example.com
OPENOUTPOSTS_INTERNAL_SECRET=replace-me

# No provider key belongs in this file. Each session fetches its own from the
# control plane at start-up, scoped to that session and answered from the
# session owner's stored credential, so one homestead serves every user without
# holding any of their keys.

# Optional.
# OPENOUTPOSTS_HOMESTEAD_ID=homestead-1              # defaults to the hostname
# OPENOUTPOSTS_CLONE_AUTH=brokered             # for machines with no ambient git access
# OPENOUTPOSTS_MAX_SESSIONS=8
# OPENOUTPOSTS_STATE_DIR is set by the unit file.
